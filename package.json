{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL Shortener: a backend for short links with expiration built with NestJS, PostgreSQL, Knex, Objection.js and Redis",
  "author": "uitop-design",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/cli.ts migrate",
    "db:rollback": "tsx --env-file-if-exists=.env src/database/cli.ts rollback",
    "db:seed": "tsx --env-file-if-exists=.env src/database/cli.ts seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "nestjs-zod": "^5.5.0",
    "objection": "^4.4.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nestjs-zod": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/swagger": "$@nestjs/swagger"
    }
  }
}
